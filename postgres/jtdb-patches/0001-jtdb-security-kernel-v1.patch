index 1df1a002a0..aeab4d31e6 100644
--- a/src/backend/jtsec/jt_sec.c
+++ b/src/backend/jtsec/jt_sec.c
@@ -259,6 +259,33 @@ jt_sec_may_admin(void)
 	return superuser();
 }
 
+/*
+ * jt_sec_check_escape_path —— 逃逸路径统一把关（docs/02 §3.5）。
+ *
+ * 为什么需要本函数而非在各子系统里各写一份判定：
+ * 逃逸路径在 PG 里**本来就没有权限门**——实测 `lo_import`/`lo_export`
+ * 对任意角色开放（`be-fsstubs.c` 内既无 `superuser()` 也无
+ * `pg_read_server_files` 检查），普通用户即可读写服务器任意文件。既然
+ * PG 不提供门，就必须由安全内核提供，且**判定规则只有一处**，避免各
+ * 调用点口径漂移（这正是前面几轮反复出问题的地方）。
+ *
+ * 判定：`jt_sec.allow_escape_paths` 关闭时一律拒绝（默认），开启时放行。
+ * 拒绝时用统一错误码 JT004，与 COPY 逃逸路径一致。
+ */
+void
+jt_sec_check_escape_path(const char *what)
+{
+	if (jt_sec_allow_escape_paths)
+		return;
+
+	ereport(ERROR,
+			(errcode(ERRCODE_JT_MAC_ESCAPE_PATH_DENIED),
+			 errmsg("MAC: %s is disabled", what),
+			 errdetail("Escape path: server-side file access can bypass kernel MAC."),
+			 errhint("Have jt_secadmin enable jt_sec.allow_escape_paths if this "
+					 "is required.")));
+}
