diff --git a/src/backend/jtsec/jt_sec_hooks.c b/src/backend/jtsec/jt_sec_hooks.c
new file mode 100644
index 0000000000..c3c13f63ca
--- /dev/null
+++ b/src/backend/jtsec/jt_sec_hooks.c
@@ -0,0 +1,209 @@
+/*-------------------------------------------------------------------------
+ *
+ * jt_sec_hooks.c
+ *		JTDB 安全内核执行点钩子：对象级 MAC 检查。
+ *
+ * ADR-011/012, docs/05 §3~§4, docs/02 §3.2 执行点清单。
+ *
+ * 实现：
+ * * 使用 PG SECURITY LABEL 基础设施（provider="jt"）存储对象级标签；
+ * * 注册 objectaccess_hook 在 OAT_POST_CREATE / OAT_DROP 等检查点
+ *   做 MAC 校验（DDL 层面）；
+ * * 注册 ExecutorStart_hook 在查询执行时校验表级标签（DML 层面）。
+ *
+ * Portions Copyright (c) 2025, JTDB Project
+ * Portions Copyright (c) 1996-2025, PostgreSQL Global Development Group
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+
+#include "catalog/objectaccess.h"
+#include "catalog/seclabel.h"
+#include "fmgr.h"
+#include "jtsec/jt_sec.h"
+#include "miscadmin.h"
+#include "nodes/nodes.h"
+#include "tcop/utility.h"
+#include "utils/rel.h"
+
+/* provider 名（SECURITY LABEL FOR 'jt' ON ...） */
+#define JT_SEC_PROVIDER "jt"
+
+/* 原始 hook 指针 */
+static ExecutorStart_hook_type prev_ExecutorStart = NULL;
+static ProcessUtility_hook_type prev_ProcessUtility = NULL;
+
+/* ------------------------------------------------------------------------
+ * 内部辅助
+ * ------------------------------------------------------------------------ */
+
+/*
+ * jt_sec_get_object_label —— 从 pg_seclabel 读取对象标签（provider="jt"）。
+ *
+ * 返回 NULL = 对象未标记（视为最低密级）。
+ */
+static JtLabel *
+jt_sec_get_object_label(Oid classoid, Oid objoid)
+{
+	ObjectAddress object;
+	char	   *seclabel_text;
+	JtLabel    *label;
+
+	object.classId = classoid;
+	object.objectId = objoid;
+	object.objectSubId = 0;
+
+	seclabel_text = GetSecurityLabel(&object, JT_SEC_PROVIDER);
+	if (seclabel_text == NULL)
+		return NULL;
+
+	label = (JtLabel *) palloc(sizeof(JtLabel));
+	if (!jt_label_parse(seclabel_text, label))
+	{
+		pfree(label);
+		return NULL;
+	}
+	return label;
+}
+
+/*
+ * jt_sec_check_table_access —— 检查表的 MAC 访问权限。
+ */
+bool
+jt_sec_check_table_access(Relation rel, JtAccessMode mode)
+{
+	JtLabel    *obj_label;
+
+	if (!jt_sec_mac_enabled)
+		return true;
+
+	obj_label = jt_sec_get_object_label(RelationGetRelid(rel), RelationGetForm(rel)->reltablespace);
+
+	return jt_sec_check_access(obj_label, mode);
+}
+
+/* ------------------------------------------------------------------------
+ * ExecutorStart 钩子：查询执行时校验表级标签
+ * ------------------------------------------------------------------------ */
+
+static void
+jt_sec_ExecutorStart(QueryDesc *queryDesc, int eflags)
+{
+	/* MAC 关闭时跳过全部检查 */
+	if (jt_sec_mac_enabled)
+	{
+		PlannedStmt *pstmt = queryDesc->plannedstmt;
+
+		if (pstmt != NULL && pstmt->commandType == CMD_SELECT)
+		{
+			/* 读路径：校验范围表（rtable）中的表标签 */
+			ListCell   *lc;
+
+			foreach(lc, pstmt->rtable)
+			{
+				RangeTblEntry *rte = (RangeTblEntry *) lfirst(lc);
+
+				if (rte->rtekind == RTE_RELATION &&
+					(rte->relkind == RELKIND_RELATION ||
+					 rte->relkind == RELKIND_PARTITIONED_TABLE))
+				{
+					Relation	rel = table_open(rte->relid, AccessShareLock);
+					JtLabel    *obj_label = jt_sec_get_object_label(
+						RelationGetRelid(rel), RelationGetForm(rel)->reltablespace);
+
+					if (obj_label != NULL)
+					{
+						if (!jt_sec_check_access(obj_label, JT_ACCESS_READ))
+						{
+							table_close(rel, AccessShareLock);
+							ereport(ERROR,
+									(errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+									 errmsg("MAC: read denied for table \"%s\" (label %s)",
+											RelationGetRelationName(rel),
+											jt_label_to_string(obj_label)),
+									 errdetail("Simple security property: subject label "
+											   "does not dominate object label.")));
+						}
+					}
+					table_close(rel, AccessShareLock);
+				}
+			}
+		}
+	}
+
+	/* 调用前一个钩子或默认实现 */
+	if (prev_ExecutorStart)
+		prev_ExecutorStart(queryDesc, eflags);
+	else
+		standard_ExecutorStart(queryDesc, eflags);
+}
+
+/* ------------------------------------------------------------------------
+ * ProcessUtility 钩子：DDL 操作时校验标签
+ * ------------------------------------------------------------------------ */
+
+static void
+jt_sec_ProcessUtility(PlannedStmt *pstmt,
+					  const char *queryString,
+					  bool readOnlyTree,
+					  ProcessUtilityContext context,
+					  ParamListInfo params,
+					  QueryEnvironment *queryEnv,
+					  DestReceiver *dest,
+					  QueryCompletion *qc)
+{
+	/* MAC 关闭时跳过全部检查 */
+	if (jt_sec_mac_enabled)
+	{
+		Node	   *parsetree = pstmt->utilityStmt;
+
+		switch (nodeTag(parsetree))
+		{
+			case T_CreateStmt:
+				if (!jt_sec_check_access(NULL, JT_ACCESS_CREATE))
+					ereport(ERROR,
+							(errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+							 errmsg("MAC: create denied (MAC enabled)")));
+				break;
+
+			case T_DropStmt:
+				/* DROP 需要写权限 */
+				if (!jt_sec_check_role(JT_ROLE_SECADMIN | JT_ROLE_SYSADMIN))
+					ereport(ERROR,
+							(errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+							 errmsg("MAC: drop denied (requires secadmin or sysadmin role)")));
+				break;
+
+			case T_AlterTableStmt:
+				if (!jt_sec_check_role(JT_ROLE_SECADMIN | JT_ROLE_SYSADMIN))
+					ereport(ERROR,
+							(errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+							 errmsg("MAC: ALTER TABLE denied (requires secadmin or sysadmin role)")));
+				break;
+
+			default:
+				break;
+		}
+	}
+
+	if (prev_ProcessUtility)
+		prev_ProcessUtility(pstmt, queryString, readOnlyTree, context,
+							params, queryEnv, dest, qc);
+	else
+		standard_ProcessUtility(pstmt, queryString, readOnlyTree, context,
+								params, queryEnv, dest, qc);
+}
+
+/* ------------------------------------------------------------------------
+ * 初始化（模块加载时调用）
+ * ------------------------------------------------------------------------ */
+
+void
+jt_sec_hooks_init(void)
+{
+	prev_ExecutorStart = ExecutorStart_hook;
+	ExecutorStart_hook = jt_sec_ExecutorStart;
+
+	prev_ProcessUtility = ProcessUtility_hook;
+	ProcessUtility_hook = jt_sec_ProcessUtility;
+}
diff --git a/src/backend/tcop/postgres.c b/src/backend/tcop/postgres.c
index 38eb258729..0d2b3dc279 100644
--- a/src/backend/tcop/postgres.c
+++ b/src/backend/tcop/postgres.c
@@ -4081,6 +4081,7 @@ PostgresSingleUserMain(int argc, char *argv[],
 	/* JTDB: register security kernel GUCs and init context (ADR-011/012) */
 	jt_sec_register_gucs();
 	jt_sec_context_init();
