 		else
 			ereport(ERROR,
-					(errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+					(errcode(ERRCODE_JT_MAC_WRITE_DENIED),
 					 errmsg("MAC: write denied for table \"%s\" (label %s)",
 							relname, labeltxt),
 					 errdetail("*-property: object label does not dominate the "
@@ -396,7 +477,14 @@ jt_sec_ProcessUtility(PlannedStmt *pstmt,
 					  DestReceiver *dest,
 					  QueryCompletion *qc)
 {
-	/* MAC 关闭时跳过全部检查 */
+	/*
+	 * MAC 关闭时跳过全部检查。
+	 *
+	 * 例外：**逃逸路径围栏独立于 MAC 开关**（见下）——它拦的是"绕过内核
+	 * 直接读写服务器文件/执行程序"的能力，与标签检查是否启用无关；若跟随
+	 * MAC 开关，攻击者只要 MAC 处于阶段 0 兼容模式（默认 off）即可自由
+	 * 读写服务器文件。故逃逸检查在 MAC 判断之外单独执行。
+	 */
 	if (jt_sec_mac_enabled)
 	{
 		Node	   *parsetree = pstmt->utilityStmt;
@@ -482,6 +570,62 @@ jt_sec_ProcessUtility(PlannedStmt *pstmt,
 		}
 	}
 
+	/*
+	 * 逃逸路径围栏（docs/02 §3.5）。
+	 *
+	 * 与 MAC 开关**无关**：这些路径让主体绕过内核直接接触服务器文件系统或
+	 * 执行外部程序（COPY ... FROM PROGRAM 直接 popen shell；COPY 文件形式
+	 * 读写服务器任意文件；大对象服务端读写同理）。若不拦，任何标签检查都
+	 * 可被"把数据抄到文件再读出来"绕过。
+	 *
+	 * 默认**禁用**（`jt_sec.allow_escape_paths = off`），业务必需时由
+	 * secadmin 开启白名单（ADR-012）。注意：PG 自身的角色门（
+	 * pg_read_server_files 等）只是**必要条件**——它由 DBA 授予，而
+	 * secadmin 未必掌握 DBA；本围栏是独立的第二道门，使"DBA 误授权"不至于
+	 * 直接变成"绕过 MAC"。
+	 *
+	 * **非后端进程豁免（`!IsUnderPostmaster`）**：`initdb` 自身要用
+	 * `COPY information_schema.sql_features FROM '<share>/sql_features.txt'`
+	 * 装载目录数据（实测：不豁免则 initdb 直接 FATAL，数据库都建不起来）。
+	 * 该进程由 initdb 直接拉起、走 `InitProcessing` 模式、**不接受客户端
+	 * 连接**，不是围栏要防的对象。
+	 *
+	 * 判据用 `!IsUnderPostmaster` 而非 `IsBootstrapProcessingMode()`：
+	 * 实测失败的 COPY 发生在 post-bootstrap 阶段，那时已是 NormalProcessing
+	 * 但**仍未** fork 自 postmaster —— `IsBootstrapProcessingMode()` 拦不住
+	 * 它。真实客户端后端一律 `IsUnderPostmaster == true`，全部受管。
+	 */
+	if (!jt_sec_allow_escape_paths && IsUnderPostmaster)
+	{
+		Node	   *parsetree = pstmt->utilityStmt;
+
+		if (nodeTag(parsetree) == T_CopyStmt)
+		{
+			CopyStmt  *stmt = (CopyStmt *) parsetree;
+
+			if (stmt->is_program)
+				ereport(ERROR,
+						(errcode(ERRCODE_JT_MAC_ESCAPE_PATH_DENIED),
+						 errmsg("MAC: COPY ... %s PROGRAM is disabled",
+								stmt->is_from ? "FROM" : "TO"),
+						 errdetail("Escape path: COPY PROGRAM executes an external "
+								   "command and can bypass kernel MAC."),
+						 errhint("Have jt_secadmin enable jt_sec.allow_escape_paths "
+								 "if this is required.")));
+
+			/* 文件形式的 COPY 读写服务器文件系统，同样属逃逸路径 */
+			if (stmt->filename != NULL && stmt->filename[0] != '\0')
+				ereport(ERROR,
+						(errcode(ERRCODE_JT_MAC_ESCAPE_PATH_DENIED),
+						 errmsg("MAC: COPY ... %s '<file>' is disabled",
+								stmt->is_from ? "FROM" : "TO"),
+						 errdetail("Escape path: server-side file access can bypass "
+								   "kernel MAC."),
+						 errhint("Use COPY ... FROM STDIN / TO STDOUT instead, or have "
+								 "jt_secadmin enable jt_sec.allow_escape_paths.")));
+		}
+	}
+
 	if (prev_ProcessUtility)
 		prev_ProcessUtility(pstmt, queryString, readOnlyTree, context,
 							params, queryEnv, dest, qc);
