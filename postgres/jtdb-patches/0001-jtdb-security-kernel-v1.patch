 src/backend/jtsec/jt_sec_hooks.c | 53 ++++++++++++++++++++++++++++++++
 1 file changed, 53 insertions(+)

diff --git a/src/backend/jtsec/jt_sec_hooks.c b/src/backend/jtsec/jt_sec_hooks.c
index 1c8ce9392d..ed8c75b36a 100644
--- a/src/backend/jtsec/jt_sec_hooks.c
+++ b/src/backend/jtsec/jt_sec_hooks.c
@@ -19,6 +19,7 @@
 
 #include "access/table.h"
 #include "catalog/catalog.h"
+#include "catalog/namespace.h"
 #include "catalog/objectaccess.h"
 #include "commands/seclabel.h"
 #include "executor/executor.h"
@@ -424,6 +425,58 @@ jt_sec_ProcessUtility(PlannedStmt *pstmt,
 							 errmsg("MAC: ALTER TABLE denied (requires secadmin or sysadmin role)")));
 				break;
 
+			/*
+			 * COPY —— **不走 ExecutorStart**（copyfrom.c 自建 ModifyTableState
+			 * 与 ResultRelInfo，直接调 table AM 的 insert 例程），因此上轮在
+			 * ExecutorStart 里做的写检查对它完全无效。
+			 *
+			 * 实测：高密会话（30:finance）对 '10:' 表执行 `COPY t FROM ...`
+			 * 成功写入 —— 违反 * 属性（禁止向下写）。此处补检查。
+			 *
+			 * 方向语义（与 INSERT 对齐）：
+			 *   - `COPY t FROM`（写表 t）→ **只做写检查**。COPY FROM 是追加，
+			 *     不读取既有行，故无需读检查；强加读检查会拒掉合法的向上写
+			 *     （与 INSERT 的处理保持一致）。
+			 *   - `COPY t TO`（读表 t）→ 只做读检查（不下读）。
+			 */
+			case T_CopyStmt:
+				{
+					CopyStmt  *stmt = (CopyStmt *) parsetree;
+					Oid			relid;
+
+					/* COPY (query) TO 无 relation；由 query 路径自身把关 */
+					if (stmt->relation == NULL)
+						break;
+
+					relid = RangeVarGetRelid(stmt->relation, AccessShareLock, false);
+
+					if (stmt->is_from)
+						jt_sec_check_rel_label(relid, JT_ACCESS_WRITE, "Write");
+					else
+						jt_sec_check_rel_label(relid, JT_ACCESS_READ, "Read");
+				}
+				break;
+
+			/*
+			 * TRUNCATE —— 同样是 utility 语句，不经 ModifyTable。语义上清空
+			 * 表是**破坏性写**，按 * 属性做写检查（实测此前可被高密会话清空
+			 * 低密表）。
+			 */
+			case T_TruncateStmt:
+				{
+					TruncateStmt *stmt = (TruncateStmt *) parsetree;
+					ListCell   *lc;
+
+					foreach(lc, stmt->relations)
+					{
+						RangeVar   *rv = (RangeVar *) lfirst(lc);
+						Oid			relid = RangeVarGetRelid(rv, AccessShareLock, false);
+
+						jt_sec_check_rel_label(relid, JT_ACCESS_WRITE, "Write");
+					}
+				}
+				break;
+
 			default:
 				break;
 		}

