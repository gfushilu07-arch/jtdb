+/* ------------------------------------------------------------------------
+ * MAC 拒绝的 E2 审计事件（docs/05 §6.2、docs/02 §7.2）
+ * ------------------------------------------------------------------------ */
+
+/*
+ * jt_sec_emit_mac_denied —— 发出 MAC 拒绝的 E2 审计事件。
+ *
+ * **为什么在这里用 LOG 而非直接写审计平面**：
+ * 审计事件需要 hash 链（h(n)=SM3(event(n)‖h(n-1))，docs/02 §7.3），而
+ * PostgreSQL 不提供 SM3（只有 MD5/SHA 系），且 docs/12 §3 明确禁止组件
+ * 自行实现密码原语。因此**内核负责"产生结构化事件"，审计平面负责"链接
+ * 与持久化"**：内核把事件以**机器可读**形式写入 PG 日志，由审计采集器
+ * （jt-audit-ingest 侧）读取、补 hash 链、落 WAL 与存储。
+ *
+ * 事件必须机器可读而非仅人读文本，故：
+ *   - 错误码用统一的 JT001-JT004（docs/05 §6.2"统一错误码"）；
+ *   - 事件体以 `JTDB-AUDIT-E2` 前缀 + 稳定字段名输出（JSON 形式），
+ *     采集器按前缀过滤、按字段名解析，不依赖本地化文本；
+ *   - `detail` 只放摘要与标签，**不放业务明文**（docs/02 §3.3）。
+ *
+ * E2 语义（docs/02 §7.2）：事务提交时同步写本地 journal。内核不持有
+ * journal（那是审计平面的职责），故此处 LOG 之后由采集器保证同步落盘；
+ * 若审计平面中断，按 §7.2 的失效矩阵应"阻断对应操作"——该阻断由审计
+ * 平面的健康状态驱动（`jt_sec.audit_required`），不在本函数内做。
+ */
+static void
+jt_sec_emit_mac_denied(const char *action, const char *object_kind,
+					   const char *object_name, const JtLabel *object_label,
+					   const JtLabel *subject_label)
+{
+	char		objlabel_buf[64];
+	char		subjlabel_buf[64];
+	char	   *objlabel_txt;
+	char	   *subjlabel_txt;
+
+	if (object_label != NULL)
+	{
+		objlabel_txt = jt_label_to_string(object_label);
+		strlcpy(objlabel_buf, objlabel_txt, sizeof(objlabel_buf));
+		pfree(objlabel_txt);
+	}
+	else
+		strlcpy(objlabel_buf, "(unlabeled)", sizeof(objlabel_buf));
+
+	if (subject_label != NULL)
+	{
+		subjlabel_txt = jt_label_to_string(subject_label);
+		strlcpy(subjlabel_buf, subjlabel_txt, sizeof(subjlabel_buf));
+		pfree(subjlabel_txt);
+	}
+	else
+		strlcpy(subjlabel_buf, "(none)", sizeof(subjlabel_buf));
+
+	ereport(LOG,
+			(errcode(ERRCODE_JT_MAC_READ_DENIED),
+			 errmsg("JTDB-AUDIT-E2 {\"event\":\"mac_denied\","
+					"\"action\":\"%s\",\"object_kind\":\"%s\","
+					"\"object\":\"%s\",\"object_label\":\"%s\","
+					"\"subject_label\":\"%s\",\"user\":\"%s\","
+					"\"database\":\"%s\",\"backend_pid\":%d}",
+					action, object_kind, object_name,
+					objlabel_buf, subjlabel_buf,
+					GetUserNameFromId(GetUserId(), true),
+					get_database_name(MyDatabaseId) ? get_database_name(MyDatabaseId) : "(none)",
+					MyProcPid)));
+}
+
 /*
  * jt_sec_check_table_access —— 检查表的 MAC 访问权限。
  */
@@ -168,7 +240,7 @@ jt_sec_check_rel_label(Oid relid, JtAccessMode mode, const char *verb)
 
 		table_close(rel, lockmode);
 		ereport(ERROR,
-				(errcode(ERRCODE_DATA_CORRUPTED),
+				(errcode(ERRCODE_JT_MAC_LABEL_MALFORMED),
 				 errmsg("MAC: label of table \"%s\" is malformed", relname),
 				 errdetail("Stored label cannot be parsed. %s is denied rather than "
 						   "treating the table as unclassified.", verb),
@@ -180,18 +252,27 @@ jt_sec_check_rel_label(Oid relid, JtAccessMode mode, const char *verb)
 	{
 		char	   *relname = pstrdup(RelationGetRelationName(rel));
 		char	   *labeltxt = pstrdup(jt_label_to_string(obj_label));
+		const JtLabel *subj = jt_sec_context_get_session_label();
 
 		table_close(rel, lockmode);
