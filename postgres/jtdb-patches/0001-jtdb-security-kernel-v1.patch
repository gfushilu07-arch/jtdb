+		 * 就来不及了（docs/02 §7.2 要求 MAC 拒绝必发 E2）。
+		 */
+		jt_sec_emit_mac_denied(mode == JT_ACCESS_READ ? "read" : "write",
+							   "table", relname, obj_label, subj);
