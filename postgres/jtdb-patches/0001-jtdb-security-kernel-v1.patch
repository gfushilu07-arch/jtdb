diff --git a/src/include/jtsec/jt_sec.h b/src/include/jtsec/jt_sec.h
new file mode 100644
index 0000000000..c3bf6444a8
--- /dev/null
+++ b/src/include/jtsec/jt_sec.h
@@ -0,0 +1,164 @@
+/*-------------------------------------------------------------------------
+ *
+ * jt_sec.h
+ *		JTDB 安全内核：安全上下文、MLS 标签模型、三权分立、超管围栏。
+ *
+ * ADR-011/012, docs/05 §2~§3。编译进 backend 的核心安全模块。
+ *
+ * 标签模型（docs/05 §3.1）：
+ *   Label = (Level, Categories)
+ *   Level: 全序整数，默认 10/20/30/40（公开/内部/秘密/机密），secadmin 可扩展
+ *   Categories: 位图（最多 32 个类别），包含关系 = 位子集
+ *   dominate(a, b) = a.Level >= b.Level AND a.Categories ⊇ b.Categories
+ *
+ * BLP 规则（docs/05 §3.2）：
+ *   简单安全属性（不下读）：主体标签须支配对象标签才可读
+ *   *-属性（不上写）：对象标签须支配主体标签才可写
+ *
+ * 三权分立（ADR-012）：
+ *   jt_secadmin  — 安全管理员（标签管理、MAC 开关）
+ *   jt_sysadmin  — 系统管理员（DDL/DML，不可标标签、不可读高密数据）
+ *   jt_auditor   — 审计员（审计查看，不可写数据）
+ *   超管围栏: superuser 不可读安全数据（jt_sec.mac_enabled 时）
+ *
+ * Portions Copyright (c) 2025, JTDB Project
+ * Portions Copyright (c) 1996-2025, PostgreSQL Global Development Group
+ *-------------------------------------------------------------------------
+ */
+#ifndef JT_SEC_H
+#define JT_SEC_H
+
+#include "fmgr.h"
+
+/* ------------------------------------------------------------------------
+ * 标签常量与类型
+ * ------------------------------------------------------------------------ */
+
+/* 默认 Level 档位 */
+#define JT_LEVEL_PUBLIC		10
+#define JT_LEVEL_INTERNAL	20
+#define JT_LEVEL_SECRET		30
+#define JT_LEVEL_TOPSECRET	40
+
+/* 默认 Level 数量上限 */
+#define JT_MAX_LEVELS		64
+
+/* Categories 位图宽度（uint32 最多 32 个类别） */
+#define JT_MAX_CATEGORIES	32
+
+/* 无效标签值 */
+#define JT_LABEL_INVALID	0
+
+/*
+ * JtLabel —— MLS 标签（Level + Categories 位图）
+ *
+ * 序列化为文本: "level:cat1,cat2,..." 或 "level" （无类别时）
+ */
+typedef struct JtLabel
+{
+	int32		level;			/* 全序等级 */
+	uint32		categories;		/* 类别位图 */
+} JtLabel;
+
+/*
+ * JtSecurityContext —— 会话安全上下文（docs/05 §2）
+ *
+ * 绑定到会话，事务级检查点：每事务开始 + 每 E3 操作前。
+ */
+typedef struct JtSecurityContext
+{
+	JtLabel		session_label;		/* 主体标签（会话建立时设置） */
+	JtLabel		write_label;		/* 写标签（可不同于会话标签；可信降标） */
+	char	   *node_id;			/* 节点标识（docs/13 身份） */
+	char	   *policy_version;		/* 策略版本（撤销检查） */
+	uint64		expires_at;			/* Unix 秒；0 = 不过期 */
+	bool		trusted;			/* 可信主体（可降标写） */
+} JtSecurityContext;
+
+/* ------------------------------------------------------------------------
+ * 三权分立角色位（ADR-012）
+ * ------------------------------------------------------------------------ */
+
+typedef enum JtSecurityRole
+{
+	JT_ROLE_NONE = 0,
+	JT_ROLE_SECADMIN = 1 << 0,	/* 安全管理员 */
+	JT_ROLE_SYSADMIN = 1 << 1,	/* 系统管理员 */
+	JT_ROLE_AUDITOR = 1 << 2,	/* 审计员 */
+	JT_ROLE_TRUSTED = 1 << 3,	/* 可信主体（可降标写） */
+} JtSecurityRole;
+
+#define JT_ROLE_ALL_ADMIN (JT_ROLE_SECADMIN | JT_ROLE_SYSADMIN | JT_ROLE_AUDITOR)
+
+/* ------------------------------------------------------------------------
+ * 全局状态
+ * ------------------------------------------------------------------------ */
+
+/* MAC 开关（jt_secadmin 可控；off 时全部标签检查跳过） */
+extern bool jt_sec_mac_enabled;
+
+/* 超管围栏（jt_sec.mac_enabled 时 superuser 也受 MAC 约束） */
+extern bool jt_sec_superuser_fence;
+
+/* 当前会话安全上下文 */
+extern JtSecurityContext *jt_sec_context;
+
+/* ------------------------------------------------------------------------
+ * 标签模型函数
+ * ------------------------------------------------------------------------ */
+
+extern bool jt_label_dominate(const JtLabel *a, const JtLabel *b);
+extern bool jt_label_equal(const JtLabel *a, const JtLabel *b);
+extern char *jt_label_to_string(const JtLabel *label);
+extern bool jt_label_parse(const char *str, JtLabel *label);
+
+/* ------------------------------------------------------------------------
+ * 访问检查
+ * ------------------------------------------------------------------------ */
+
+typedef enum JtAccessMode
+{
+	JT_ACCESS_READ = 'r',
+	JT_ACCESS_WRITE = 'w',
+	JT_ACCESS_CREATE = 'c',
+	JT_ACCESS_ALTER = 'a',
+	JT_ACCESS_DROP = 'd',
+} JtAccessMode;
+
+extern bool jt_sec_check_access(const JtLabel *object_label, JtAccessMode mode);
+extern bool jt_sec_check_role(JtSecurityRole required);
+extern bool jt_sec_is_secadmin(void);
+extern bool jt_sec_is_sysadmin(void);
+extern bool jt_sec_is_auditor(void);
+extern bool jt_sec_is_superuser_fenced(void);
+
+/* ------------------------------------------------------------------------
+ * 上下文管理
+ * ------------------------------------------------------------------------ */
+
+extern void jt_sec_context_init(void);
+extern void jt_sec_context_set_label(const JtLabel *label);
+extern void jt_sec_context_set_write_label(const JtLabel *label);
+extern const JtLabel *jt_sec_context_get_session_label(void);
+extern const JtLabel *jt_sec_context_get_write_label(void);
+extern void jt_sec_context_set_trusted(bool trusted);
+extern bool jt_sec_context_is_trusted(void);
+
+/* ------------------------------------------------------------------------
+ * SQL 接口（fmgr）
+ * ------------------------------------------------------------------------ */
+
+extern PGDLLEXPORT Datum jt_sec_set_session_label(PG_FUNCTION_ARGS);
+extern PGDLLEXPORT Datum jt_sec_get_session_label(PG_FUNCTION_ARGS);
+extern PGDLLEXPORT Datum jt_sec_set_mac_enabled(PG_FUNCTION_ARGS);
+extern PGDLLEXPORT Datum jt_sec_get_mac_enabled(PG_FUNCTION_ARGS);
+extern PGDLLEXPORT Datum jt_sec_check_access_sql(PG_FUNCTION_ARGS);
+extern PGDLLEXPORT Datum jt_sec_label_dominate_sql(PG_FUNCTION_ARGS);
+
+/* ------------------------------------------------------------------------
+ * GUC 注册
+ * ------------------------------------------------------------------------ */
+
+extern void jt_sec_register_gucs(void);
+
+#endif							/* JT_SEC_H */
-- 
