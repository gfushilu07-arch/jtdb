+/*
+ * jt_sec_object_relabel —— 标签写入前的校验钩子。
+ *
+ * PG 在 `SECURITY LABEL FOR 'jt' ON ... IS '<label>'` 存储前调用本钩子。
+ * 这里**解析一次**：不合法即报错，使 pg_seclabel 里不会存进无法解析的
+ * 标签——从源头消除"损坏标签"状态，而不是只在下游 fail-closed 兜底。
+ *
+ * 仍保留下游的 MALFORMED 处理：标签可能由超级用户直接改目录表、或由
+ * 旧版本写入，纵深防御不可省。
+ */
+static void
+jt_sec_object_relabel(const ObjectAddress *object, const char *seclabel)
+{
+	JtLabel		label;
+
+	if (seclabel == NULL)
+		return;
+
+	if (!jt_label_parse(seclabel, &label))
