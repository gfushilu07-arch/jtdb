diff --git a/src/backend/jtsec/jt_sec.c b/src/backend/jtsec/jt_sec.c
new file mode 100644
index 0000000000..79f82fa22f
--- /dev/null
+++ b/src/backend/jtsec/jt_sec.c
@@ -0,0 +1,476 @@
+/*-------------------------------------------------------------------------
+ *
+ * jt_sec.c
+ *		JTDB 安全内核：MLS 标签模型、三权分立、超管围栏。
+ *
+ * ADR-011/012, docs/05 §2~§3。
+ *
+ * Portions Copyright (c) 2025, JTDB Project
+ * Portions Copyright (c) 1996-2025, PostgreSQL Global Development Group
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+
+#include "fmgr.h"
+#include "jtsec/jt_sec.h"
+#include "lib/stringinfo.h"
+#include "miscadmin.h"
+#include "utils/builtins.h"
+#include "utils/memutils.h"
+
+/* ------------------------------------------------------------------------
+ * 全局状态
+ * ------------------------------------------------------------------------ */
+
+bool		jt_sec_mac_enabled = false;
+bool		jt_sec_superuser_fence = false;
+
+/* 会话安全上下文（TopMemoryContext 分配，会话生命周期） */
+static JtSecurityContext jt_sec_ctx;
+
+/* 当前角色位图（运行时设置；v1 从 GUC 读取） */
+static uint32 jt_sec_current_roles = JT_ROLE_NONE;
+
+/* 默认类别名表（secadmin 可扩展；v1 硬编码 8 个） */
+static const char *jt_category_names[JT_MAX_CATEGORIES] = {
+	"finance", "hr", "legal", "medical",
+	"defense", "intel", "infra", "custom8",
+};
+
+/* ------------------------------------------------------------------------
+ * 标签模型
+ * ------------------------------------------------------------------------ */
+
+/*
+ * jt_label_dominate —— 判断标签 a 是否支配标签 b。
+ *
+ * dominate(a, b) = a.Level >= b.Level AND a.Categories ⊇ b.Categories
+ *
+ * 返回 true = a 支配 b（a 可以读 b，b 可以写在 a 的层级上）。
+ */
+bool
+jt_label_dominate(const JtLabel *a, const JtLabel *b)
+{
+	if (a == NULL || b == NULL)
+		return false;
+	return (a->level >= b->level) &&
+		((a->categories & b->categories) == b->categories);
+}
+
+/*
+ * jt_label_equal —— 标签相等。
+ */
+bool
+jt_label_equal(const JtLabel *a, const JtLabel *b)
+{
+	if (a == NULL || b == NULL)
+		return a == b;
+	return a->level == b->level && a->categories == b->categories;
+}
+
+/*
+ * jt_label_to_string —— 序列化为 "level:cat1,cat2"。
+ */
+char *
+jt_label_to_string(const JtLabel *label)
+{
+	StringInfoData buf;
+	bool		first_cat = true;
+
+	initStringInfo(&buf);
+	appendStringInfo(&buf, "%d:", label->level);
+
+	for (int i = 0; i < JT_MAX_CATEGORIES; i++)
+	{
+		if (label->categories & (1U << i))
+		{
+			if (!first_cat)
+				appendStringInfoChar(&buf, ',');
+			appendStringInfoString(&buf, jt_category_names[i]);
+			first_cat = false;
+		}
+	}
+	return buf.data;
+}
+
+/*
+ * jt_label_parse —— 解析 "level:cat1,cat2"。
+ *
+ * 返回 true = 成功。
+ */
+bool
+jt_label_parse(const char *str, JtLabel *label)
+{
+	char	   *copy;
+	char	   *colon;
+	char	   *cat_str;
+	int			level;
+
+	label->level = JT_LEVEL_PUBLIC;
+	label->categories = 0;
+
+	if (str == NULL || *str == '\0')
+		return true;			/* 空标签 = 最低密级 */
+
+	copy = pstrdup(str);
+
+	/* 拆分 level:categories */
+	colon = strchr(copy, ':');
+	if (colon == NULL)
+	{
+		/* 纯 level（无类别） */
+		level = pg_strtoint32(copy);
+		if (level < JT_LEVEL_PUBLIC || level > JT_LEVEL_PUBLIC + JT_MAX_LEVELS)
+			return false;
+		label->level = level;
+		return true;
+	}
+
+	*colon = '\0';
+	cat_str = colon + 1;
+
+	level = pg_strtoint32(copy);
+	if (level < JT_LEVEL_PUBLIC || level > JT_LEVEL_PUBLIC + JT_MAX_LEVELS)
+		return false;
+	label->level = level;
+
+	/* 解析类别名 → 位图 */
+	if (*cat_str != '\0')
+	{
+		char	   *token;
+		char	   *saveptr;
+
+		for (token = strtok_r(cat_str, ",", &saveptr);
+			 token != NULL;
+			 token = strtok_r(NULL, ",", &saveptr))
+		{
+			for (int i = 0; i < JT_MAX_CATEGORIES; i++)
+			{
+				if (strcmp(token, jt_category_names[i]) == 0)
+				{
+					label->categories |= (1U << i);
+					break;
+				}
+			}
+			/* 未知类别名：忽略（宽容解析） */
+		}
+	}
+
+	return true;
+}
+
+/* ------------------------------------------------------------------------
+ * 三权分立（ADR-012）
+ * ------------------------------------------------------------------------ */
+
+/*
+ * jt_sec_set_roles —— 设置当前角色（从 GUC jt_sec.roles 调用）。
+ */
+void
+jt_sec_set_roles(uint32 roles)
+{
+	/* 互斥校验：secadmin 和 sysadmin 不可同时持有（三权分立核心） */
+	if ((roles & JT_ROLE_SECADMIN) && (roles & JT_ROLE_SYSADMIN))
+		ereport(ERROR,
+				(errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+				 errmsg("jt_secadmin and jt_sysadmin roles are mutually exclusive"),
+				 errdetail("Three-way separation of duties (ADR-012).")));
+
+	jt_sec_current_roles = roles;
+}
+
+bool
+jt_sec_is_secadmin(void)
+{
+	return (jt_sec_current_roles & JT_ROLE_SECADMIN) != 0;
+}
+
+bool
+jt_sec_is_sysadmin(void)
+{
+	return (jt_sec_current_roles & JT_ROLE_SYSADMIN) != 0;
+}
+
+bool
+jt_sec_is_auditor(void)
+{
+	return (jt_sec_current_roles & JT_ROLE_AUDITOR) != 0;
+}
+
+/*
+ * jt_sec_is_superuser_fenced —— 超管是否被围栏限制。
+ *
+ * 当 MAC 启用且围栏开启时，superuser 也受 MAC 约束（不可绕过）。
+ */
+bool
+jt_sec_is_superuser_fenced(void)
+{
+	return jt_sec_mac_enabled && jt_sec_superuser_fence && superuser();
+}
+
+/* ------------------------------------------------------------------------
+ * BLP 访问检查（docs/05 §3.2）
+ * ------------------------------------------------------------------------ */
+
+/*
+ * jt_sec_check_access —— BLP 强制访问控制检查。
+ *
+ * MAC 关闭时全部通过（阶段 0 兼容模式）。
+ * MAC 开启时：
+ *   - superuser + 围栏 → 仍走 BLP（不可绕过）
+ *   - 读：主体标签须支配对象标签（不下读）
+ *   - 写：对象标签须支配主体写标签（不上写），除非主体可信（可降标写）
+ *   - 无对象标签（未标记）：视为最低密级（公开），默认放行
+ */
+bool
+jt_sec_check_access(const JtLabel *object_label, JtAccessMode mode)
+{
+	const JtLabel *subject_label;
+
+	/* MAC 关闭：全通（阶段 0 兼容模式） */
+	if (!jt_sec_mac_enabled)
+		return true;
+
+	/* 对象未标记：视为最低密级 */
+	if (object_label == NULL ||
+		(object_label->level == JT_LEVEL_PUBLIC && object_label->categories == 0))
+		return true;
+
+	subject_label = &jt_sec_ctx.session_label;
+
+	switch (mode)
+	{
+		case JT_ACCESS_READ:
+			/* 简单安全属性：不下读 */
+			return jt_label_dominate(subject_label, object_label);
+
+		case JT_ACCESS_WRITE:
+		case JT_ACCESS_CREATE:
+		case JT_ACCESS_ALTER:
+		case JT_ACCESS_DROP:
+			/* *-属性：不上写（使用写标签，可信主体可降标） */
+			{
+				const JtLabel *wlabel = jt_sec_context_is_trusted()
+					? &jt_sec_ctx.write_label
+					: &jt_sec_ctx.session_label;
+				return jt_label_dominate(object_label, wlabel);
+			}
+
+		default:
+			return false;
+	}
+}
+
+/*
+ * jt_sec_check_role —— 角色检查。
+ */
+bool
+jt_sec_check_role(JtSecurityRole required)
+{
+	return (jt_sec_current_roles & required) == required;
+}
+
+/* ------------------------------------------------------------------------
+ * 上下文管理
+ * ------------------------------------------------------------------------ */
+
+void
+jt_sec_context_init(void)
+{
+	memset(&jt_sec_ctx, 0, sizeof(JtSecurityContext));
+	jt_sec_ctx.session_label.level = JT_LEVEL_PUBLIC;
+	jt_sec_ctx.write_label.level = JT_LEVEL_PUBLIC;
+	jt_sec_ctx.node_id = pstrdup("");
+	jt_sec_ctx.policy_version = pstrdup("");
+	jt_sec_ctx.expires_at = 0;
+	jt_sec_ctx.trusted = false;
+	jt_sec_current_roles = JT_ROLE_NONE;
+}
+
+void
+jt_sec_context_set_label(const JtLabel *label)
+{
+	if (label != NULL)
+		jt_sec_ctx.session_label = *label;
+}
+
+void
+jt_sec_context_set_write_label(const JtLabel *label)
+{
+	if (label != NULL)
+		jt_sec_ctx.write_label = *label;
+}
+
+const JtLabel *
+jt_sec_context_get_session_label(void)
+{
+	return &jt_sec_ctx.session_label;
+}
+
+const JtLabel *
+jt_sec_context_get_write_label(void)
+{
+	return &jt_sec_ctx.write_label;
+}
+
+void
+jt_sec_context_set_trusted(bool trusted)
+{
+	jt_sec_ctx.trusted = trusted;
+}
+
+bool
+jt_sec_context_is_trusted(void)
+{
+	return jt_sec_ctx.trusted;
+}
+
+/* ------------------------------------------------------------------------
+ * GUC 注册（jt_sec.* 前缀）
+ * ------------------------------------------------------------------------ */
+
+static const struct config_enum_entry jt_sec_role_options[] = {
+	{"none", JT_ROLE_NONE, false},
+	{"secadmin", JT_ROLE_SECADMIN, false},
+	{"sysadmin", JT_ROLE_SYSADMIN, false},
+	{"auditor", JT_ROLE_AUDITOR, false},
+	{"trusted", JT_ROLE_TRUSTED, false},
+	{NULL, 0, false},
+};
+
+/* GUC 变量（桥接到 jt_sec_current_roles） */
+static int	jt_sec_role_guc = JT_ROLE_NONE;
+
+static void
+jt_sec_role_assign_hook(int newval, void *extra)
+{
+	jt_sec_set_roles((uint32) newval);
+}
+
+void
+jt_sec_register_gucs(void)
+{
+	DefineCustomBoolVariable(
+		"jt_sec.mac_enabled",
+		"Enable MAC (Mandatory Access Control) label checks",
+		"When on, BLP rules (no read down, no write up) are enforced. "
+		"Only jt_secadmin can toggle.",
+		&jt_sec_mac_enabled,
+		false,
+		PGC_USERSET,
+		0,
+		NULL, NULL, NULL);
+
+	DefineCustomBoolVariable(
+		"jt_sec.superuser_fence",
+		"Fence superuser from bypassing MAC checks",
+		"When on, superuser is also subject to MAC (ADR-012 fence).",
+		&jt_sec_superuser_fence,
+		false,
+		PGC_SIGHUP,
+		0,
+		NULL, NULL, NULL);
+
+	DefineCustomEnumVariable(
+		"jt_sec.role",
+		"Active security role (three-way separation)",
+		"secadmin and sysadmin are mutually exclusive (ADR-012).",
+		&jt_sec_role_guc,
+		JT_ROLE_NONE,
+		jt_sec_role_options,
+		PGC_USERSET,
+		0,
+		NULL,
+		jt_sec_role_assign_hook,
+		NULL);
+}
+
+/* ------------------------------------------------------------------------
+ * SQL 接口（fmgr）
+ * ------------------------------------------------------------------------ */
+
+PG_MODULE_MAGIC;
+
+Datum
+jt_sec_set_session_label(PG_FUNCTION_ARGS)
+{
+	text	   *label_text = PG_GETARG_TEXT_PP(0);
+	JtLabel		label;
+
+	if (!jt_sec_is_secadmin() && !superuser())
+		ereport(ERROR,
+				(errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+				 errmsg("only jt_secadmin can set session label")));
+
+	if (!jt_label_parse(text_to_cstring(label_text), &label))
+		ereport(ERROR,
+				(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+				 errmsg("invalid label format: %s", text_to_cstring(label_text))));
+
+	jt_sec_context_set_label(&label);
+	PG_RETURN_TEXT_P(cstring_to_text(jt_label_to_string(&label)));
+}
+
+Datum
+jt_sec_get_session_label(PG_FUNCTION_ARGS)
+{
+	const JtLabel *label = jt_sec_context_get_session_label();
+	PG_RETURN_TEXT_P(cstring_to_text(jt_label_to_string(label)));
+}
+
+Datum
+jt_sec_set_mac_enabled(PG_FUNCTION_ARGS)
+{
+	bool		enable = PG_GETARG_BOOL(0);
+
+	if (!jt_sec_is_secadmin() && !superuser())
+		ereport(ERROR,
+				(errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+				 errmsg("only jt_secadmin can toggle MAC")));
+
+	jt_sec_mac_enabled = enable;
+	PG_RETURN_BOOL(jt_sec_mac_enabled);
+}
+
+Datum
+jt_sec_get_mac_enabled(PG_FUNCTION_ARGS)
+{
+	PG_RETURN_BOOL(jt_sec_mac_enabled);
+}
+
+Datum
+jt_sec_check_access_sql(PG_FUNCTION_ARGS)
+{
+	text	   *label_text = PG_GETARG_TEXT_PP(0);
+	text	   *mode_text = PG_GETARG_TEXT_PP(1);
+	JtLabel		label;
+	JtAccessMode mode;
+
+	if (!jt_label_parse(text_to_cstring(label_text), &label))
+		PG_RETURN_BOOL(false);
+
+	switch (VARSIZE(mode_text) - VARHDRSZ > 0 ? *VARDATA(mode_text) : 'r')
+	{
+		case 'w': mode = JT_ACCESS_WRITE; break;
+		case 'c': mode = JT_ACCESS_CREATE; break;
+		case 'a': mode = JT_ACCESS_ALTER; break;
+		case 'd': mode = JT_ACCESS_DROP; break;
+		default:  mode = JT_ACCESS_READ; break;
+	}
+
+	PG_RETURN_BOOL(jt_sec_check_access(&label, mode));
+}
+
+Datum
+jt_sec_label_dominate_sql(PG_FUNCTION_ARGS)
+{
+	text	   *a_text = PG_GETARG_TEXT_PP(0);
+	text	   *b_text = PG_GETARG_TEXT_PP(1);
+	JtLabel		a, b;
+
+	if (!jt_label_parse(text_to_cstring(a_text), &a) ||
+		!jt_label_parse(text_to_cstring(b_text), &b))
+		PG_RETURN_BOOL(false);
+
+	PG_RETURN_BOOL(jt_label_dominate(&a, &b));
+}
