+/*
+ * jt_sec_object_relabel —— 标签写入前的校验钩子。
+ *
+ * PG 在 `SECURITY LABEL FOR 'jt' ON ... IS '<label>'` 存储前调用本钩子。
+ * 这里**解析一次**：不合法即报错，使 pg_seclabel 里不会存进无法解析的
+ * 标签——从源头消除"损坏标签"状态，而不是只在下游 fail-closed 兜底。
+ *
+ * 仍保留下游的 MALFORMED 处理：标签可能由超级用户直接改目录表、或由
+ * 旧版本写入，纵深防御不可省。
+ */
+static void
+jt_sec_object_relabel(const ObjectAddress *object, const char *seclabel)
+{
+	JtLabel		label;
+
+	if (seclabel == NULL)
+		return;
+
+	if (!jt_label_parse(seclabel, &label))
+		ereport(ERROR,
+				(errcode(ERRCODE_INVALID_NAME),
+				 errmsg("'%s' is not a valid JTDB security label", seclabel),
+				 errhint("Expected \"level[:cat1,cat2,...]\" with level in [%d,%d] "
+						 "and known category names (e.g. '30:finance').",
+						 JT_LEVEL_PUBLIC, JT_LEVEL_PUBLIC + JT_MAX_LEVELS)));
+}
+
 /* ------------------------------------------------------------------------
  * 初始化（模块加载时调用）
  * ------------------------------------------------------------------------ */
 
+/*
+ * 幂等守卫。
+ *
+ * **必须幂等**：PostgresSingleUserMain 与 PostgresMain 都会调用本函数，
+ * 而前者随后进入后者——同一进程内会调用两次。若不守卫，第二次执行
+ * `prev_ProcessUtility = ProcessUtility_hook` 时读到的是**自己**，于是
+ * prev_* 指向 jt_sec_ProcessUtility，形成自递归：任何 DDL 都会无限递归
+ * 直至栈耗尽/卡死（实测 `initdb` 的 post-bootstrap 阶段即挂死在
+ * jt_sec_hooks.c:258 的 prev_ProcessUtility 调用上）。
+ */
+static bool jt_sec_hooks_installed = false;
+
 void
 jt_sec_hooks_init(void)
 {
+	if (jt_sec_hooks_installed)
+		return;
+	jt_sec_hooks_installed = true;
+
 	prev_ExecutorStart = ExecutorStart_hook;
 	ExecutorStart_hook = jt_sec_ExecutorStart;
 
 	prev_ProcessUtility = ProcessUtility_hook;
 	ProcessUtility_hook = jt_sec_ProcessUtility;
+
+	/*
+	 * 注册标签提供者。**不注册则 `SECURITY LABEL FOR 'jt'` 直接报
+	 * "security label provider \"jt\" is not loaded"**——标签根本写不进去，
+	 * 整套 MAC 无从落地（此前实测即如此）。
+	 */
+	register_label_provider(JT_SEC_PROVIDER, jt_sec_object_relabel);
 }
